# Copy this file to .env and fill in real paths.
# .env is gitignored and must never be committed.

# Path to the granite-4.1-8b-base HuggingFace checkpoint directory.
HF_ASSETS_PATH=/path/to/granite-4.1-8b-sft-hf-assets

# Path to the SFT dataset directory containing .jsonl files.
DATA_PATH=/path/to/sft-data
